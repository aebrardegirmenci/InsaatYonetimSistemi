@model InsaatYonetimi.Models.Work

@{
    ViewData["Title"] = "İşçiliği Sil";
}

<div class="project-page">

    <div class="project-header">

        <div>
            <h1>İşçiliği Sil</h1>
            <p>Bu işçilik kaydını silmek istediğinizden emin misiniz?</p>
        </div>

        <a asp-action="Index" class="back-button">
            <i class="bi bi-arrow-left"></i>
            İşçiliklere Dön
        </a>

    </div>

    <div class="project-form-card">

        <div class="form-section">

            <h2>İşçilik Bilgileri</h2>

            <div class="form-grid">

                <div class="form-item">
                    <label>İşçi</label>
                    <div class="form-control">
                        @Model.Worker.Name
                    </div>
                </div>

                <div class="form-item">
                    <label>Proje</label>
                    <div class="form-control">
                        @Model.Project.Name
                    </div>
                </div>

                <div class="form-item">
                    <label>Başlangıç Tarihi</label>
                    <div class="form-control">
                        @Model.StartDate.ToString("dd.MM.yyyy")
                    </div>
                </div>

                <div class="form-item">
                    <label>Gün Sayısı</label>
                    <div class="form-control">
                        @Model.DayCount gün
                    </div>
                </div>

                <div class="form-item">
                    <label>Günlük Ücret</label>
                    <div class="form-control">
                        @Model.Worker.DailyPay.ToString("N2") ₺
                    </div>
                </div>

                <div class="form-item">
                    <label>Toplam Maliyet</label>
                    <div class="form-control">
                        @((Model.DayCount * Model.Worker.DailyPay).ToString("N2")) ₺
                    </div>
                </div>

            </div>

        </div>

        <div class="form-actions">

            <a asp-action="Index"
               class="cancel-button">
                Vazgeç
            </a>

            <form asp-action="Delete" method="post">

                <input type="hidden" asp-for="WorkId" />

                @Html.AntiForgeryToken()

                <button type="submit" class="delete-button">
                    <i class="bi bi-trash"></i>
                    İşçiliği Sil
                </button>

            </form>

        </div>

    </div>

</div>
