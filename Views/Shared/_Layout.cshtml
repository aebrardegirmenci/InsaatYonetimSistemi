<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - InsaatYonetimi</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <link rel="stylesheet"
          href="~/InsaatYonetimi.styles.css"
          asp-append-version="true" />
</head>

<body>

    @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Home")
    {
        @RenderBody()
    }
    else
    {
        <div class="dashboard">

            <aside class="sidebar">

                <div class="sidebar-logo">
                    <img src="~/images/logo.png" />
                </div>

                <nav class="menu">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                        <i class="bi bi-house"></i>
                        Ana Sayfa
                    </a>

                    <a asp-controller="Projects"
                       asp-action="Index"
                       class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Projects" ? "active" : "")">
                        <i class="bi bi-building"></i>
                        Projeler
                    </a>

                    <a asp-controller="Workers"
                       asp-action="Index"
                       class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Workers" ? "active" : "")">
                        <i class="bi bi-people"></i>
                        İşçiler
                    </a>

                    <a asp-controller="Works"
                       asp-action="Index"
                       class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Works" ? "active" : "")">
                        <i class="bi bi-person-workspace"></i>
                        İşçilikler
                    </a>

                    <a asp-controller="Materials"
                       asp-action="Index"
                       class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Materials" ? "active" : "")">
                        <i class="bi bi-box-seam"></i>
                        Malzemeler
                    </a>

                    <a asp-controller="Suppliers"
                       asp-action="Index"
                       class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Suppliers" ? "active" : "")">
                        <i class="bi bi-truck"></i>
                        Tedarikçiler
                    </a>

                    <a asp-controller="Expenses"
                       asp-action="Index"
                       class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Expenses" ? "active" : "")">
                        <i class="bi bi-wallet2"></i>
                        Giderler
                    </a>

                    <a asp-controller="Incomes"
                       asp-action="Index"
                       class="menu-item">
                        <i class="bi bi-arrow-up-circle"></i>
                        Gelirler
                    </a>

                    <a asp-controller="Account"
                       asp-action="Settings"
                       class="menu-item">

                        <i class="bi bi-gear"></i>
                        Ayarlar

                    </a>

                </nav>

                <a asp-controller="Account"
                   asp-action="Logout"
                   class="logout-item">

                    <i class="bi bi-box-arrow-right"></i>
                    Çıkış Yap

                </a>

            </aside>

            <main class="main-content">

                @RenderBody()

            </main>

        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>