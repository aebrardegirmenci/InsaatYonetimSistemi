@model InsaatYonetimi.Models.Material

@{
    ViewData["Title"] = "Yeni Malzeme";
}

<div class="project-page">

    <div class="project-header">
        <div>
            <h1>Yeni Malzeme</h1>
            <p>Projede kullanılacak malzemeyi kaydedin.</p>
        </div>

        <a asp-action="Index" class="back-button">
            <i class="bi bi-arrow-left"></i>
            Malzemelere Dön
        </a>
    </div>

    <div class="project-form-card">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="form-section">

                <h2>Malzeme Bilgileri</h2>

                <div class="form-grid">

                    <div class="form-item">
                        <label asp-for="Name">Malzeme Adı</label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Örn. Çimento" />

                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>

                    <div class="form-item">
                        <label asp-for="Category">Kategori</label>

                        <input asp-for="Category"
                               class="form-control"
                               placeholder="Örn. İnşaat" />

                        <span asp-validation-for="Category"
                              class="text-danger"></span>
                    </div>

                    <div class="form-item">
                        <label asp-for="ProjectId">Proje</label>

                        <select asp-for="ProjectId"
                                class="form-control">

                            <option value="">Proje seçin</option>

                            @foreach (var project in ViewBag.Projects)
                            {
                                <option value="@project.ProjectId">
                                    @project.Name
                                </option>
                            }

                        </select>
                    </div>

                    <div class="form-item">
                        <label asp-for="SupplierId">Tedarikçi</label>

                        <select asp-for="SupplierId"
                                class="form-control">

                            <option value="">Tedarikçi seçin</option>

                            @foreach (var supplier in ViewBag.Suppliers)
                            {
                                <option value="@supplier.SupplierId">
                                    @supplier.Name
                                </option>
                            }

                        </select>
                    </div>

                    <div class="form-item">
                        <label asp-for="Unit">Birim</label>

                        <input asp-for="Unit"
                               class="form-control"
                               placeholder="Örn. kg, adet, m³" />
                    </div>

                    <div class="form-item">
                        <label asp-for="Quantity">Miktar</label>

                        <input asp-for="Quantity"
                               type="number"
                               step="0.01"
                               class="form-control" />
                    </div>

                    <div class="form-item">
                        <label asp-for="Price">Birim Fiyat</label>

                        <input asp-for="Price"
                               type="number"
                               step="0.01"
                               class="form-control" />
                    </div>

                    <div class="form-item">
                        <label asp-for="Date">Tarih</label>

                        <input asp-for="Date"
                               type="date"
                               class="form-control" />
                    </div>

                </div>

            </div>

            <div class="form-actions">

                <a asp-action="Index"
                   class="cancel-button">
                    İptal
                </a>

                <button type="submit"
                        class="save-button">
                    <i class="bi bi-check-lg"></i>
                    Malzemeyi Kaydet
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}