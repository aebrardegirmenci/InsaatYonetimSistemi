@model InsaatYonetimi.Models.Expense

@{
    ViewData["Title"] = "Gider Detayı";
}

<div class="project-page">

    <div class="project-header">

        <div>
            <h1>Gider Detayı</h1>
            <p>Gider bilgilerini görüntüleyin.</p>
        </div>

        <a asp-action="Index" class="back-button">
            <i class="bi bi-arrow-left"></i>
            Giderlere Dön
        </a>

    </div>

    <div class="project-form-card">

        <div class="form-section">

            <h2>Gider Bilgileri</h2>

            <div class="form-grid">

                <div class="form-item">
                    <label>Gider Adı</label>
                    <input value="@Model.Name"
                           class="form-control"
                           readonly />
                </div>

                <div class="form-item">
                    <label>Proje</label>
                    <input value="@Model.Project.Name"
                           class="form-control"
                           readonly />
                </div>

                <div class="form-item">
                    <label>Tutar</label>
                    <input value="@Model.Amount.ToString("N2") ₺"
                           class="form-control"
                           readonly />
                </div>

                <div class="form-item">
                    <label>Tarih</label>
                    <input value="@Model.Date.ToString("dd.MM.yyyy")"
                           class="form-control"
                           readonly />
                </div>

                <div class="form-item" style="grid-column: 1 / -1;">
                    <label>Açıklama</label>
                    <textarea class="form-control"
                              rows="4"
                              readonly>@Model.Description</textarea>
                </div>

            </div>

        </div>

        <div class="form-actions">

            <a asp-action="Index" class="cancel-button">
                Geri Dön
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.ExpenseId"
               class="save-button">
                <i class="bi bi-pencil"></i>
                Düzenle
            </a>

        </div>

    </div>

</div>