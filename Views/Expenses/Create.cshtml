@model InsaatYonetimi.Models.Expense

@{
    ViewData["Title"] = "Yeni Gider";
}

<div class="project-page">

    <div class="project-header">

        <div>
            <h1>Yeni Gider</h1>
            <p>Yeni bir gider kaydı oluşturun.</p>
        </div>

        <a asp-action="Index" class="back-button">
            <i class="bi bi-arrow-left"></i>
            Giderlere Dön
        </a>

    </div>

    <div class="project-form-card">

        <form asp-action="Create" method="post">

            <div class="form-section">

                <h2>Gider Bilgileri</h2>

                <div class="form-grid">

                    <div class="form-item">
                        <label asp-for="Name">Gider Adı</label>
                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Örn. Elektrik faturası" />
                    </div>

                    <div class="form-item">
                        <label asp-for="ProjectId">Proje</label>

                        <select asp-for="ProjectId" class="form-control">
                            <option value="">Proje seçin</option>

                            @foreach (var project in ViewBag.Projects)
                            {
                                <option value="@project.ProjectId">
                                    @project.Name
                                </option>
                            }

                        </select>
                    </div>

                    <div class="form-item">
                        <label asp-for="Amount">Tutar</label>
                        <input asp-for="Amount"
                               type="number"
                               step="0.01"
                               class="form-control"
                               placeholder="Örn. 1500" />
                    </div>

                    <div class="form-item">
                        <label asp-for="Date">Tarih</label>
                        <input asp-for="Date"
                               type="date"
                               class="form-control" />
                    </div>

                    <div class="form-item" style="grid-column: 1 / -1;">
                        <label asp-for="Description">Açıklama</label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Gider hakkında açıklama"></textarea>
                    </div>

                </div>

            </div>

            <div class="form-actions">

                <a asp-action="Index" class="cancel-button">
                    İptal
                </a>

                <button type="submit" class="save-button">
                    <i class="bi bi-check-lg"></i>
                    Gideri Kaydet
                </button>

            </div>

        </form>

    </div>

</div>