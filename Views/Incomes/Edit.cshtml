@model InsaatYonetimi.Models.Income

@{
    ViewData["Title"] = "Geliri Düzenle";
}

<div class="project-page">

    <div class="project-header">

        <div>
            <h1>Geliri Düzenle</h1>
            <p>Gelir bilgilerini güncelleyin.</p>
        </div>

        <a asp-action="Index" class="back-button">
            <i class="bi bi-arrow-left"></i>
            Gelirlere Dön
        </a>

    </div>

    <div class="project-form-card">

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="IncomeId" />

            <div class="form-section">

                <h2>Gelir Bilgileri</h2>

                <div class="form-grid">

                    <div class="form-item">

                        <label asp-for="ProjectId">Proje</label>

                        <select asp-for="ProjectId" class="form-control">

                            @foreach (var project in ViewBag.Projects)
                            {
                                <option value="@project.ProjectId">
                                    @project.Name
                                </option>
                            }

                        </select>

                    </div>

                    <div class="form-item">

                        <label asp-for="Amount">Tutar</label>

                        <input asp-for="Amount"
                               type="number"
                               step="0.01"
                               class="form-control" />

                    </div>

                    <div class="form-item">

                        <label asp-for="Date">Tarih</label>

                        <input asp-for="Date"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="form-item">

                        <label asp-for="Description">Açıklama</label>

                        <input asp-for="Description"
                               class="form-control" />

                    </div>

                </div>

            </div>

            <div class="form-actions">

                <a asp-action="Index" class="cancel-button">
                    İptal
                </a>

                <button type="submit" class="save-button">
                    <i class="bi bi-check-lg"></i>
                    Değişiklikleri Kaydet
                </button>

            </div>

        </form>

    </div>

</div>