@model IEnumerable<InsaatYonetimi.Models.Worker>

@{
    ViewData["Title"] = "İşçiler";
}

<div class="project-page">

    <div class="project-header">

        <div>
            <h1>İşçiler</h1>
            <p>Çalışanlarınızı buradan yönetin.</p>
        </div>

        <a asp-controller="Workers"
           asp-action="Create"
           class="save-button">
            <i class="bi bi-plus-lg"></i>
            Yeni İşçi Ekle
        </a>

    </div>

    <div class="project-list-card">

        @if (Model.Any())
        {
            <div class="table-responsive">

                <table class="project-table">

                    <thead>
                        <tr>
                            <th>Ad Soyad</th>
                            <th>Meslek</th>
                            <th>Günlük Ücret</th>
                            <th>Telefon</th>
                            <th>Adres</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>@item.Name</strong>
                                </td>

                                <td>
                                    @item.Job
                                </td>

                                <td>
                                    @item.DailyPay.ToString("N2") ₺
                                </td>

                                <td>
                                    @(item.Phone ?? "-")
                                </td>

                                <td>
                                    @(item.Address ?? "-")
                                </td>

                                <td>

                                    <div class="project-actions">

                                        <a asp-controller="Workers"
                                           asp-action="Details"
                                           asp-route-id="@item.WorkerId"
                                           title="Detay">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-controller="Workers"
                                           asp-action="Edit"
                                           asp-route-id="@item.WorkerId"
                                           title="Düzenle">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-controller="Workers"
                                           asp-action="Delete"
                                           asp-route-id="@item.WorkerId"
                                           title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div style="padding: 40px; text-align: center; color: #888;">
                Henüz kayıtlı işçi bulunmuyor.
            </div>
        }

    </div>

</div>