@model InsaatYonetimi.Models.Project

@{
    ViewData["Title"] = "Proje Detayı";

    decimal materialExpense = Model.Materials
        .Sum(x => x.Quantity * x.Price);

    decimal workExpense = Model.Works
        .Sum(x => x.DayCount * x.Worker.DailyPay);

    decimal otherExpense = Model.Expenses
        .Sum(x => x.Amount);

    decimal totalExpense = materialExpense + workExpense + otherExpense;

    decimal remainingBudget = Model.Budget - totalExpense;
}

<div class="project-page">

    <div class="project-header">

        <div>
            <h1>Proje Detayı</h1>
            <p>@Model.Name projesinin bilgileri.</p>
        </div>

        <a asp-action="Index" class="back-button">
            <i class="bi bi-arrow-left"></i>
            Projelere Dön
        </a>

    </div>

    <div class="project-form-card">

        <div class="form-section">

            <h2>Proje Bilgileri</h2>

            <div class="form-grid">

                <div class="form-item">
                    <label>Proje Adı</label>
                    <div class="form-control">
                        @Model.Name
                    </div>
                </div>

                <div class="form-item">
                    <label>Adres</label>
                    <div class="form-control">
                        @Model.Address
                    </div>
                </div>

                <div class="form-item">
                    <label>Başlangıç Tarihi</label>
                    <div class="form-control">
                        @Model.StartDate
                    </div>
                </div>

                <div class="form-item">
                    <label>Bütçe</label>
                    <div class="form-control">
                        @Model.Budget.ToString("N2") ₺
                    </div>
                </div>

                <div class="form-item">
                    <label>Alan</label>
                    <div class="form-control">
                        @(Model.Area.HasValue
                                                ? Model.Area.Value.ToString("N2") + " m²"
                                                : "-")
                    </div>
                </div>

                <div class="form-item">
                    <label>Kat Sayısı</label>
                    <div class="form-control">
                        @(Model.FloorCount.HasValue
                                                ? Model.FloorCount.ToString()
                                                : "-")
                    </div>
                </div>

                <div class="form-item">
                    <label>Daire Sayısı</label>
                    <div class="form-control">
                        @(Model.ApartmentCount.HasValue
                                                ? Model.ApartmentCount.ToString()
                                                : "-")
                    </div>
                </div>

                <div class="form-item">
                    <label>Durum</label>

                    <div class="form-control">

                        @switch (Model.Status)
                        {
                            case InsaatYonetimi.Models.ProjectStatus.DevamEden:
                                <span class="project-status status-devam">
                                    <span class="project-status-dot"></span>
                                    Devam Eden
                                </span>
                                break;

                            case InsaatYonetimi.Models.ProjectStatus.Tamamlanan:
                                <span class="project-status status-tamamlanan">
                                    <span class="project-status-dot"></span>
                                    Tamamlanan
                                </span>
                                break;

                            case InsaatYonetimi.Models.ProjectStatus.Planlanan:
                                <span class="project-status status-planlanan">
                                    <span class="project-status-dot"></span>
                                    Planlanan
                                </span>
                                break;

                            case InsaatYonetimi.Models.ProjectStatus.Beklemede:
                                <span class="project-status status-beklemede">
                                    <span class="project-status-dot"></span>
                                    Beklemede
                                </span>
                                break;
                        }

                    </div>

                </div>

            </div>

        </div>

        <div class="form-section">

            <h2>Finansal Bilgiler</h2>

            <div class="form-grid">

                <div class="form-item">
                    <label>Malzeme Gideri</label>
                    <div class="form-control">
                        @materialExpense.ToString("N2") ₺
                    </div>
                </div>

                <div class="form-item">
                    <label>İşçilik Gideri</label>
                    <div class="form-control">
                        @workExpense.ToString("N2") ₺
                    </div>
                </div>

                <div class="form-item">
                    <label>Diğer Giderler</label>
                    <div class="form-control">
                        @otherExpense.ToString("N2") ₺
                    </div>
                </div>

                <div class="form-item">
                    <label>Toplam Harcama</label>
                    <div class="form-control">
                        <strong>@totalExpense.ToString("N2") ₺</strong>
                    </div>
                </div>

                <div class="form-item">
                    <label>Kalan Bütçe</label>
                    <div class="form-control">
                        <strong>@remainingBudget.ToString("N2") ₺</strong>
                    </div>
                </div>

            </div>

        </div>

        <div class="form-actions">

            <a asp-action="Index" class="cancel-button">
                Geri Dön
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.ProjectId"
               class="save-button">

                <i class="bi bi-pencil"></i>
                Projeyi Düzenle

            </a>

        </div>

    </div>

</div>