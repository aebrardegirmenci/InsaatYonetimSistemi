@model InsaatYonetimi.Models.Project

@{
    ViewData["Title"] = "Proje Ekle";
}

<div class="project-page">

    <div class="project-header">
        <div>
            <h1>Yeni Proje</h1>
            <p>Yeni bir proje oluşturun.</p>
        </div>

        <a asp-action="Index" class="back-button">
            <i class="bi bi-arrow-left"></i>
            Projelere Dön
        </a>
    </div>


    <div class="project-form-card">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>


            <div class="form-section">

                <h2>Proje Bilgileri</h2>

                <div class="form-grid">

                    <div class="form-item">
                        <label asp-for="Name">Proje Adı</label>
                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Proje adını girin" />
                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>


                    <div class="form-item">
                        <label asp-for="Address">Adres</label>
                        <input asp-for="Address"
                               class="form-control"
                               placeholder="Proje adresini girin" />
                        <span asp-validation-for="Address"
                              class="text-danger"></span>
                    </div>


                    <div class="form-item">
                        <label asp-for="StartDate">Başlangıç Tarihi</label>
                        <input asp-for="StartDate"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="StartDate"
                              class="text-danger"></span>
                    </div>


                    <div class="form-item">
                        <label asp-for="Budget">Bütçe</label>
                        <input asp-for="Budget"
                               type="number"
                               step="0.01"
                               class="form-control"
                               placeholder="0,00" />
                        <span asp-validation-for="Budget"
                              class="text-danger"></span>
                    </div>


                    <div class="form-item">
                        <label asp-for="Area">Alan (m²)</label>
                        <input asp-for="Area"
                               type="number"
                               step="0.01"
                               class="form-control"
                               placeholder="Örn. 2500" />
                        <span asp-validation-for="Area"
                              class="text-danger"></span>
                    </div>


                    <div class="form-item">
                        <label asp-for="FloorCount">Kat Sayısı</label>
                        <input asp-for="FloorCount"
                               type="number"
                               class="form-control"
                               placeholder="Örn. 8" />
                        <span asp-validation-for="FloorCount"
                              class="text-danger"></span>
                    </div>


                    <div class="form-item">
                        <label asp-for="ApartmentCount">Daire Sayısı</label>
                        <input asp-for="ApartmentCount"
                               type="number"
                               class="form-control"
                               placeholder="Örn. 40" />
                        <span asp-validation-for="ApartmentCount"
                              class="text-danger"></span>
                    </div>

                </div>

            </div>


            <div class="form-section">

                <h2>Proje Durumu</h2>

                <div class="status-options">

                    <label class="status-option">
                        <input asp-for="Status" type="radio" value="DevamEden" checked />

                        <span class="status-dot status-blue"></span>

                        <span class="status-text">
                            <strong>Devam Eden</strong>
                            <small>Proje şu anda devam ediyor.</small>
                        </span>
                    </label>


                    <label class="status-option">
                        <input asp-for="Status" type="radio" value="Tamamlanan" />

                        <span class="status-dot status-green"></span>

                        <span class="status-text">
                            <strong>Tamamlanan</strong>
                            <small>Proje tamamlandı.</small>
                        </span>
                    </label>


                    <label class="status-option">
                        <input asp-for="Status" type="radio" value="Planlanan" />

                        <span class="status-dot status-orange"></span>

                        <span class="status-text">
                            <strong>Planlanan</strong>
                            <small>Proje planlama aşamasında.</small>
                        </span>
                    </label>


                    <label class="status-option">
                        <input asp-for="Status" type="radio" value="Beklemede" />

                        <span class="status-dot status-gray"></span>

                        <span class="status-text">
                            <strong>Beklemede</strong>
                            <small>Proje henüz başlamadı.</small>
                        </span>
                    </label>

                </div>

            </div>


            <div class="form-actions">

                <a asp-action="Index" class="cancel-button">
                    İptal
                </a>
                <button type="submit" class="save-button">
                    <i class="bi bi-check-lg"></i>
                    Projeyi Kaydet
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}